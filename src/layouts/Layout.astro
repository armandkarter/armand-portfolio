---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DJEHA Armand Sedjro - Full Stack Developer" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#020302] text-white font-mono overflow-x-hidden relative min-h-screen flex flex-col justify-between">
    
    <!-- Background Matrix -->
    <div class="fixed inset-0 -z-10 bg-[linear-gradient(rgba(0,0,0,0.75),rgba(0,0,0,0.95)),repeating-linear-gradient(90deg,transparent_0,transparent_45px,rgba(82,255,0,0.05)_46px)] pointer-events-none"></div>

    <!-- En-tête globale -->
    <Navbar />

    <!-- Contenu de la page -->
    <slot />

    <!-- Bas de page global -->
    <Footer />

  </body>
</html>