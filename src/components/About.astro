---
---

<section id="about" class="w-[94%] max-w-[1450px] mx-auto py-20 border-t border-[#1f3a1b]">
  <!-- Label de section -->
  <div class="text-[#52ff00] text-xs font-mono mb-2">&gt; /about</div>
  <h2 class="text-3xl sm:text-5xl font-bold mb-12 text-white">
    À propos de <span class="text-[#52ff00]">moi</span>
  </h2>

  <div class="grid grid-cols-1 lg:grid-cols-[58%_38%] gap-12 items-start">
    
    <!-- Partie Gauche : Présentation & Parcours Académique -->
    <div class="space-y-8 font-mono">
      <div class="space-y-4">
        <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
          Je suis <strong class="text-white">DJEHA Armand Sedjro</strong>, Développeur Full Stack Indépendant (Freelance) spécialisé dans la conception d'applications web et mobiles performantes.
        </p>

        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed">
          Passionné par le développement logiciel, j'allie une formation académique solide en Génie Logiciel à des compétences pratiques pour concevoir des architectures robustes et sécurisées. Je suis également disponible pour des missions en <span class="text-[#52ff00]">Remote</span>.
        </p>
      </div>

      <!-- Bloc Parcours Scolaire & Académique -->
      <div class="pt-4 border-t border-[#1d4317]/60">
        <h3 class="text-xs uppercase tracking-widest text-[#52ff00] mb-6 flex items-center gap-2">
          <span>&gt;</span> PARCOURS_ACADÉMIQUE_&_DIPLÔMES
        </h3>

        <div class="relative border-l border-[#1d4317] ml-2 space-y-6">
          
          <!-- Master IFRI (En cours) -->
          <div class="relative pl-6 group">
            <div class="absolute -left-[5px] top-1.5 w-2 h-2 bg-[#52ff00] rounded-full animate-pulse"></div>
            <span class="text-[10px] text-[#52ff00] bg-[#1d4317]/40 border border-[#1d4317] px-2 py-0.5">
              EN COURS (2026 - Present)
            </span>
            <h4 class="text-white text-sm font-bold mt-2">
              Master en Génie Logiciel
            </h4>
            <p class="text-gray-400 text-xs">Institut de Formation et de Recherche en Informatique (IFRI)</p>
          </div>

          <!-- Certification FORCE N -->
          <div class="relative pl-6 group">
            <div class="absolute -left-[4px] top-1.5 w-2 h-2 bg-[#020302] border border-[#52ff00]"></div>
            <span class="text-[10px] text-gray-400 font-mono">[ Août 2026 ]</span>
            <h4 class="text-white text-sm font-bold">
              Certification Informatique & Internet
            </h4>
            <p class="text-gray-400 text-xs">Programme FORCE N</p>
          </div>

          <!-- Licence Nationale -->
          <div class="relative pl-6 group">
            <div class="absolute -left-[4px] top-1.5 w-2 h-2 bg-[#020302] border border-[#52ff00]"></div>
            <span class="text-[10px] text-gray-400 font-mono">[ 2021 - 2025 ]</span>
            <h4 class="text-white text-sm font-bold">
              Licence Nationale & Attestation de Fin de Formation
            </h4>
            <p class="text-gray-400 text-xs">Université Le Faucon (Formation 2021-2024 & Stage professionnel 1 an en 2024)</p>
          </div>

          <!-- BAC D -->
          <div class="relative pl-6 group">
            <div class="absolute -left-[4px] top-1.5 w-2 h-2 bg-[#020302] border border-[#1d4317]"></div>
            <span class="text-[10px] text-gray-500 font-mono">[ 2021 ]</span>
            <h4 class="text-gray-300 text-xs font-bold">
              Baccalauréat Scientifique (Série D)
            </h4>
            <p class="text-gray-500 text-[11px]">CEG 1 Abomey-Calavi</p>
          </div>

          <!-- BEPC -->
          <div class="relative pl-6 group">
            <div class="absolute -left-[4px] top-1.5 w-2 h-2 bg-[#020302] border border-[#1d4317]"></div>
            <span class="text-[10px] text-gray-500 font-mono">[ 2017 ]</span>
            <h4 class="text-gray-300 text-xs font-bold">
              Brevet d'Études du Premier Cycle (BEPC)
            </h4>
            <p class="text-gray-500 text-[11px]">CEG 2 Bohicon</p>
          </div>

        </div>
      </div>
    </div>

    <!-- Partie Droite : Terminal de Statut / Bio Synthétique -->
    <div class="bg-[#050605] border border-[#1d4317] p-6 font-mono relative sticky top-24">
      <!-- En-tête Terminal -->
      <div class="flex items-center justify-between border-b border-[#1d4317] pb-3 mb-4 text-xs text-gray-500">
        <div class="flex gap-1.5">
          <span class="w-2 h-2 rounded-full bg-red-500/80"></span>
          <span class="w-2 h-2 rounded-full bg-yellow-500/80"></span>
          <span class="w-2 h-2 rounded-full bg-[#52ff00]"></span>
        </div>
        <span>bio_info.json</span>
      </div>

      <!-- Contenu JSON Style -->
      <div class="text-xs leading-relaxed space-y-2">
        <p class="text-gray-500">&#123;</p>
        <p class="pl-4 text-gray-400"><span class="text-[#52ff00]">"nom"</span>: <span class="text-white">"DJEHA Armand Sedjro"</span>,</p>
        <p class="pl-4 text-gray-400"><span class="text-[#52ff00]">"status"</span>: <span class="text-white">"Freelance / Remote"</span>,</p>
        <p class="pl-4 text-gray-400"><span class="text-[#52ff00]">"etude_actuelle"</span>: <span class="text-white">"Master Génie Logiciel (IFRI)"</span>,</p>
        <p class="pl-4 text-gray-400"><span class="text-[#52ff00]">"stack_principale"</span>: [</p>
        <p class="pl-8 text-white">"Astro", "Laravel", "React Native", "Next.js", "JavaScript/TypeScript"</p>
        <p class="pl-4 text-gray-400">],</p>
        <p class="pl-4 text-gray-400"><span class="text-[#52ff00]">"certification"</span>: <span class="text-white">"FORCE N (08/2026)"</span>,</p>
        <p class="pl-4 text-gray-400"><span class="text-[#52ff00]">"disponibilite"</span>: <span class="text-[#52ff00]">"Disponible pour projets"</span></p>
        <p class="text-gray-500">&#125;</p>
      </div>

      <!-- Indicateur de disponibilité -->
      <div class="mt-6 pt-3 border-t border-[#1d4317] flex items-center justify-between text-[10px] text-gray-500">
        <span>WORK: FREELANCE & REMOTE</span>
        <span class="flex items-center gap-1.5 text-[#52ff00]">
          <span class="w-2 h-2 bg-[#52ff00] rounded-full animate-ping"></span>
          ONLINE
        </span>
      </div>
    </div>

  </div>
</section>