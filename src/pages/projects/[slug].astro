---
import Layout from '../../layouts/Layout.astro';
import pool from '../../lib/db';

const { slug } = Astro.params;

let project: any = null;

try {
  const result = await pool.query(
    'SELECT * FROM projects WHERE slug = $1 OR id::text = $1',
    [slug]
  );

  if (result.rows.length > 0) {
    project = result.rows[0];
  }
} catch (error) {
  console.error('Erreur lors du chargement du projet :', error);
}

if (!project) {
  return Astro.redirect('/#projects');
}

const parseTags = (tags: string[] | string): string[] => {
  if (Array.isArray(tags)) return tags;
  if (typeof tags === 'string') return tags.split(',').map((t) => t.trim()).filter(Boolean);
  return [];
};

const techs = parseTags(project.tags);
const gallery = Array.isArray(project.gallery_images) ? project.gallery_images : [];
---

<Layout title={`${project.title} | Portfolio`}>
  <main class="w-[94%] max-w-[1200px] mx-auto pt-28 pb-20 text-slate-200 font-mono min-h-screen">
    
    <!-- Bouton Retour -->
    <div class="mb-8">
      <a 
        href="/#projects" 
        class="inline-flex items-center gap-2 text-xs text-[#52ff00] hover:underline border border-[#1d4317] bg-[#050605] px-4 py-2 transition-all hover:border-[#52ff00]"
      >
        &lt; Retour aux projets
      </a>
    </div>

    <!-- Section Header -->
    <section class="border border-[#1d4317] bg-[#050605] p-6 sm:p-10 mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[#52ff00] text-xs uppercase tracking-widest border border-[#52ff00]/30 px-2.5 py-1">
          {project.category || 'Application'}
        </span>
        {project.featured && (
          <span class="text-xs text-amber-400 font-bold">★ PROJET EN VEDETTE</span>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-white mb-6">
        {project.title}
      </h1>

      <div class="flex flex-wrap gap-2 mb-8">
        {techs.map((tech) => (
          <span class="text-xs text-[#7fa878] bg-[#1d4317]/30 border border-[#1d4317] px-3 py-1 font-mono">
            {tech}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-4 pt-6 border-t border-[#1d4317]">
        {project.demo_url && (
          <a 
            href={project.demo_url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-[#52ff00] text-black font-bold px-6 py-3 text-xs hover:bg-[#42cc00] transition-colors inline-flex items-center gap-2"
          >
            Voir la démo en direct ↗
          </a>
        )}

        <a 
          href="/#contact" 
          class="border border-[#52ff00] text-[#52ff00] font-bold px-6 py-3 text-xs hover:bg-[#52ff00]/10 transition-colors inline-flex items-center gap-2"
        >
          Commander un projet similaire ✉
        </a>
      </div>
    </section>

    <!-- Cover Image -->
    {project.cover_image && (
      <section class="border border-[#1d4317] bg-[#050605] p-2 mb-8">
        <img 
          src={project.cover_image} 
          alt={project.title} 
          class="w-full max-h-[600px] object-cover"
        />
      </section>
    )}

    <!-- Description -->
    <section class="border border-[#1d4317] bg-[#050605] p-6 sm:p-10 mb-8">
      <h2 class="text-lg font-bold text-[#52ff00] mb-4 border-b border-[#1d4317] pb-2">
        &gt; Description du projet
      </h2>
      <div class="text-gray-300 text-sm leading-relaxed whitespace-pre-line font-mono">
        {project.description}
      </div>
    </section>

    <!-- Galerie -->
    {gallery.length > 0 && (
      <section class="border border-[#1d4317] bg-[#050605] p-6 sm:p-10 mb-8">
        <h2 class="text-lg font-bold text-[#52ff00] mb-6 border-b border-[#1d4317] pb-2">
          &gt; Captures d'écran
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {gallery.map((imgUrl: string, idx: number) => (
            <div class="border border-[#1d4317] overflow-hidden">
              <img 
                src={imgUrl} 
                alt={`${project.title} - capture ${idx + 1}`} 
                class="w-full h-64 object-cover hover:scale-105 transition-transform duration-300"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Call To Action -->
    <section class="border border-[#52ff00]/40 bg-[#050605] p-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl font-bold text-white mb-2">Un projet en vue ?</h3>
        <p class="text-xs text-gray-400">Obtenez un devis rapide ou discutons de vos besoins techniques.</p>
      </div>
      <a 
        href="/#contact" 
        class="bg-[#52ff00] text-black font-extrabold px-6 py-3 text-xs hover:bg-[#42cc00] transition-colors whitespace-nowrap"
      >
        CONTACTEZ-MOI &gt;
      </a>
    </section>

  </main>
</Layout>