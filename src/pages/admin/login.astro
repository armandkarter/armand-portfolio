---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Login | Portfolio Terminal">
  <main class="min-h-screen flex items-center justify-center p-4 bg-slate-950 text-emerald-400 font-mono">
    <div class="w-full max-w-md border border-emerald-500/40 bg-slate-900/80 p-6 rounded-lg shadow-2xl shadow-emerald-950/50 backdrop-blur">
      <!-- Terminal Header -->
      <div class="flex items-center justify-between border-b border-emerald-500/30 pb-3 mb-6">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="text-xs text-emerald-600 ml-2">auth_terminal.sh</span>
        </div>
        <span class="text-xs text-emerald-500/60">SECURE ACCESS</span>
      </div>

      <div class="mb-6">
        <h1 class="text-xl font-bold text-emerald-300 flex items-center gap-2">
          <span class="text-emerald-500">&gt;</span> AUTHENTIFICATION ADMIN
        </h1>
        <p class="text-xs text-emerald-500/70 mt-1">Veuillez entrer vos identifiants pour accéder à la console.</p>
      </div>

      <!-- Formulaire de login -->
      <form class="space-y-4" action="/admin/dashboard" method="GET">
        <div>
          <label class="block text-xs uppercase tracking-wider text-emerald-400/80 mb-1">&gt; Nom d'utilisateur</label>
          <input 
            type="text" 
            name="username" 
            required 
            placeholder="admin"
            class="w-full bg-slate-950 border border-emerald-500/30 rounded px-3 py-2 text-sm text-emerald-200 placeholder-emerald-800 focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400"
          />
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-emerald-400/80 mb-1">&gt; Mot de passe</label>
          <input 
            type="password" 
            name="password" 
            required 
            placeholder="••••••••"
            class="w-full bg-slate-950 border border-emerald-500/30 rounded px-3 py-2 text-sm text-emerald-200 placeholder-emerald-800 focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400"
          />
        </div>

        <button 
          type="submit" 
          class="w-full mt-2 bg-emerald-600/20 hover:bg-emerald-500/30 border border-emerald-500/60 text-emerald-300 font-semibold py-2 px-4 rounded transition duration-200 flex items-center justify-center gap-2 group"
        >
          <span>Connexion Système</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </button>
      </form>
    </div>
  </main>
</Layout>