---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ProjectsTable, { type Project } from '../admin/ProjectsTable.astro';
import pool from '../../lib/db';

let projects: Project[] = [];
let dbConnected = false;

try {
  const result = await pool.query(
    'SELECT id, title, slug, category, tags, featured, status, created_at FROM projects ORDER BY created_at DESC'
  );
  projects = result.rows;
  dbConnected = true;
} catch (error) {
  console.error('Erreur lors de la récupération des projets :', error);
}

const totalProjects = projects.length;
const featuredProjectsCount = projects.filter((p) => p.featured).length;
---

<AdminLayout title="Console Admin | Projets" activeTab="projects">
  
  <!-- Header -->
  <div slot="header" class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900/60 p-5 rounded-2xl border border-slate-800">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-100">Gestion des Projets</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-0.5">Créez, éditez et organisez vos réalisations.</p>
    </div>
    <a 
      href="/admin/projects/new" 
      class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-4 py-2.5 rounded-xl text-sm transition shadow-lg shadow-emerald-500/10 active:scale-95"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      Nouveau Projet
    </a>
  </div>

  <!-- Cartes de Statistiques -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Total Projets</span>
      <span class="text-3xl font-extrabold text-slate-100 font-mono mt-2 block">{totalProjects}</span>
    </div>
    <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">En Vedette</span>
      <span class="text-3xl font-extrabold text-amber-400 font-mono mt-2 block">{featuredProjectsCount}</span>
    </div>
    <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Vues Totales</span>
      <span class="text-3xl font-extrabold text-cyan-400 font-mono mt-2 block">4.3k</span>
    </div>
    <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Base de données</span>
      {dbConnected ? (
        <span class="text-sm font-semibold text-emerald-400 mt-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Connecté (Neon)
        </span>
      ) : (
        <span class="text-sm font-semibold text-red-400 mt-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-red-400"></span>
          Déconnecté
        </span>
      )}
    </div>
  </div>

  <!-- Table des Projets (Composant) -->
  <ProjectsTable projects={projects} />

</AdminLayout>