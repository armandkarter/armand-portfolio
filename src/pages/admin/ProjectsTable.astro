---
export interface Project {
  id: number;
  title: string;
  slug: string;
  category: string;
  tags: string[] | string;
  featured: boolean;
  status: string;
  created_at: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Fonction helper pour parser les tags
const parseTags = (tags: string[] | string): string[] => {
  if (Array.isArray(tags)) return tags;
  if (typeof tags === 'string') return tags.split(',').map((t) => t.trim()).filter(Boolean);
  return [];
};
---

<div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead class="bg-slate-950/70 text-slate-400 text-[11px] uppercase tracking-wider border-b border-slate-800">
        <tr>
          <th class="p-4">Projet</th>
          <th class="p-4">Catégorie</th>
          <th class="p-4">Technologies</th>
          <th class="p-4">Statut</th>
          <th class="p-4">Date</th>
          <th class="p-4 text-center">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-slate-300">
        {projects.length === 0 ? (
          <tr>
            <td colspan="6" class="p-8 text-center text-slate-500">
              Aucun projet enregistré pour le moment.
            </td>
          </tr>
        ) : (
          projects.map((p) => {
            const tagList = parseTags(p.tags);
            const formattedDate = new Date(p.created_at).toLocaleDateString('fr-FR', {
              day: '2-digit',
              month: 'short',
              year: 'numeric'
            });

            return (
              <tr class="hover:bg-slate-800/30 transition group">
                <!-- Titre & Slug -->
                <td class="p-4">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-slate-100 group-hover:text-emerald-400 transition-colors">{p.title}</span>
                    {p.featured && (
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-400/10 text-amber-400 border border-amber-400/20" title="En vedette">
                        ★ Vedette
                      </span>
                    )}
                  </div>
                  <div class="text-[11px] text-slate-500 font-mono mt-0.5">/{p.slug}</div>
                </td>

                <!-- Catégorie -->
                <td class="p-4">
                  <span class="px-2.5 py-1 bg-slate-950 border border-slate-800 text-slate-300 rounded-lg text-xs font-medium">
                    {p.category}
                  </span>
                </td>

                <!-- Technologies -->
                <td class="p-4">
                  <div class="flex gap-1.5 flex-wrap max-w-xs">
                    {tagList.map((tag) => (
                      <span class="px-2 py-0.5 bg-slate-950 border border-slate-800/80 text-slate-400 rounded text-[11px] font-mono">
                        {tag}
                      </span>
                    ))}
                  </div>
                </td>

                <!-- Statut -->
                <td class="p-4">
                  <span class="text-xs text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full font-medium inline-block">
                    {p.status || 'Publié'}
                  </span>
                </td>

                <!-- Date -->
                <td class="p-4 text-xs font-mono text-slate-400 whitespace-nowrap">
                  {formattedDate}
                </td>

                <!-- Actions Ajustées -->
                <td class="p-4 text-center whitespace-nowrap">
                  <div class="inline-flex items-center justify-center gap-1.5 bg-slate-950/60 p-1 rounded-xl border border-slate-800">
                    
                    <!-- Bouton Éditer -->
                    <a 
                      href={`/admin/projects/edit/${p.id}`} 
                      class="p-2 text-slate-400 hover:text-cyan-400 hover:bg-cyan-500/10 rounded-lg transition"
                      title="Éditer le projet"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    </a>

                    <!-- Séparateur -->
                    <span class="w-px h-4 bg-slate-800"></span>

                    <!-- Bouton Supprimer -->
                    <button 
                      data-id={p.id}
                      class="delete-btn p-2 text-slate-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition bg-transparent border-none cursor-pointer"
                      title="Supprimer le projet"
                    >
                      <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>

                  </div>
                </td>
              </tr>
            );
          })
        )}
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll('.delete-btn').forEach((button) => {
    button.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const id = target.dataset.id;

      if (!id) return;

      if (confirm('Êtes-vous sûr de vouloir supprimer ce projet ? Cette action est irréversible.')) {
        try {
          const response = await fetch(`/api/projects/${id}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Erreur lors de la suppression du projet.');
          }
        } catch (error) {
          console.error('Erreur :', error);
          alert('Impossible de contacter le serveur.');
        }
      }
    });
  });
</script>